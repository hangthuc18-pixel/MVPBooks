@{
    ViewData["Title"] = "Tổng quan thư viện";
}

<div class="container page-container">
    <div class="page-heading">
        <div>
            <span class="eyebrow">MVPBOOKS · QUẢN TRỊ</span>
            <h1>Tổng quan thư viện</h1>
            <p>Theo dõi nhanh tình hình danh mục sách trong hệ thống.</p>
        </div>
        <a asp-action="Index" class="btn btn-primary">Quản lý sách <span aria-hidden="true">→</span></a>
    </div>

    <div class="row g-3 g-lg-4">
        <div class="col-sm-6 col-xl-4">
            <div class="stat-card stat-primary">
                <div class="stat-label">Tổng số đầu sách</div>
                <div class="stat-value">@ViewBag.TotalBooks</div>
                <div class="stat-note">Số mã sách đang quản lý</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="stat-card stat-success">
                <div class="stat-label">Tổng số bản sách</div>
                <div class="stat-value">@ViewBag.TotalCopies</div>
                <div class="stat-note">Tổng số lượng theo danh mục</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="stat-card stat-info">
                <div class="stat-label">Tổng số thể loại</div>
                <div class="stat-value">@ViewBag.TotalCategories</div>
                <div class="stat-note">Các thể loại đang được sử dụng</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-6">
            <div class="stat-card stat-danger">
                <div class="stat-label">Đầu sách hết hàng</div>
                <div class="stat-value">@ViewBag.OutOfStock</div>
                <div class="stat-note">Số đầu sách có số lượng bằng 0</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-6">
            <div class="stat-card stat-warning">
                <div class="stat-label">Đầu sách sắp hết</div>
                <div class="stat-value">@ViewBag.LowStock</div>
                <div class="stat-note">Còn từ 1 đến 5 bản sách</div>
            </div>
        </div>
    </div>

    <div class="card app-card mt-4">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="h5 mb-1">Quản lý danh mục sách</h2>
                <p class="text-secondary mb-0">Thêm mới, tra cứu, cập nhật và xóa thông tin sách.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary">Mở danh sách sách</a>
        </div>
    </div>
</div>
