
@model IEnumerable<MVPBooks.Models.Book>

@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="container mt-4 mb-5">

    <!-- Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Quản lý sách</h2>
            <p class="text-muted mb-0">
                Quản lý thông tin và số lượng sách trong thư viện.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            + Thêm sách
        </a>

    </div>

    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <strong>Thành công!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>

        </div>
    }

    <!-- Nội dung quản lý -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-3 p-md-4">

            <!-- Tìm kiếm và lọc -->
            <form asp-action="Index" method="get" class="mb-4">

                <div class="row g-3">

                    <div class="col-lg-5">
                        <label class="form-label fw-semibold">
                            Tìm kiếm
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.CurrentFilter"
                               class="form-control"
                               placeholder="Mã sách, tên sách hoặc tác giả..." />
                    </div>

                    <div class="col-lg-3">
                        <label class="form-label fw-semibold">
                            Thể loại
                        </label>

                        <select name="category" class="form-select">

                            <option value="">Tất cả thể loại</option>

                            @foreach (var item in ViewBag.Categories)
                            {
                                if (ViewBag.CurrentCategory == item)
                                {
                                    <option value="@item" selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-lg-2">
                        <label class="form-label fw-semibold">
                            Trạng thái
                        </label>

                        <select name="stockStatus" class="form-select">

                            <option value="">Tất cả</option>

                            <option value="inStock"
                                    selected="@(ViewBag.CurrentStockStatus == "inStock" ? "selected" : null)">
                                Còn hàng
                            </option>

                            <option value="outOfStock"
                                    selected="@(ViewBag.CurrentStockStatus == "outOfStock" ? "selected" : null)">
                                Hết hàng
                            </option>

                        </select>
                    </div>

                    <div class="col-lg-2 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Tìm kiếm
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Xóa lọc
                        </a>

                    </div>

                </div>
            </form>

            <hr />

            <!-- Thông tin kết quả -->
            <div class="d-flex flex-wrap justify-content-between
                        align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    Danh sách sách
                </h5>

                <span class="text-muted small">
                    Tổng số kết quả:
                    <strong>@ViewBag.TotalItems</strong> sách
                </span>

            </div>

            <!-- Bảng dữ liệu -->
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th class="text-nowrap">Mã sách</th>
                            <th>Tên sách</th>
                            <th>Tác giả</th>
                            <th>Thể loại</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var book in Model)
                            {
                                <tr>

                                    <td class="fw-semibold text-nowrap">
                                        @book.Code
                                    </td>

                                    <td style="min-width: 160px;
                                               max-width: 260px;
                                               overflow-wrap: anywhere;">
                                        @book.Name
                                    </td>

                                    <td style="min-width: 120px;
                                               overflow-wrap: anywhere;">
                                        @book.Author
                                    </td>

                                    <td>
                                        @book.Category
                                    </td>

                                    <td class="text-center">
                                        <strong>@book.Quantity</strong>
                                    </td>

                                    <td class="text-center">

                                        @if (book.Quantity > 0)
                                        {
                                            <span class="badge bg-success">
                                                Còn hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Hết hàng
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center
                                                    flex-wrap gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@book.Id"
                                               class="btn btn-info btn-sm">
                                                Xem
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@book.Id"
                                               class="btn btn-warning btn-sm">
                                                Sửa
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@book.Id"
                                               class="btn btn-danger btn-sm">
                                                Xóa
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <h5 class="mb-2">
                                            Chưa tìm thấy sách
                                        </h5>

                                        <p class="mb-0">
                                            Vui lòng thử lại với từ khóa
                                            hoặc điều kiện lọc khác.
                                        </p>

                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- Phân trang -->
            @if (ViewBag.TotalPages > 1)
            {
                <hr />

                <nav aria-label="Phân trang">

                    <ul class="pagination justify-content-center mb-0">

                        <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage - 1)"
                               asp-route-searchString="@ViewBag.CurrentFilter"
                               asp-route-category="@ViewBag.CurrentCategory"
                               asp-route-stockStatus="@ViewBag.CurrentStockStatus">
                                Trước
                            </a>

                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.CurrentFilter"
                                   asp-route-category="@ViewBag.CurrentCategory"
                                   asp-route-stockStatus="@ViewBag.CurrentStockStatus">
                                    @i
                                </a>

                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage + 1)"
                               asp-route-searchString="@ViewBag.CurrentFilter"
                               asp-route-category="@ViewBag.CurrentCategory"
                               asp-route-stockStatus="@ViewBag.CurrentStockStatus">
                                Sau
                            </a>

                        </li>

                    </ul>

                </nav>
            }

        </div>

    </div>

</div>
